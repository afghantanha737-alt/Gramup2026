# ===== اجباری =====
# توکن ربات تلگرام (از BotFather)
BOT_TOKEN=
# آدرس اتصال MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/gramup
# کلید ورود به پنل ادمین (/admin.html) — یک رشته‌ی طولانی و تصادفی بگذارید
ADMIN_KEY=

# ===== آدرس‌ها =====
PORT=3000
# آدرس عمومی برنامه (برای ثبت webhook و لینک‌ها) مثلاً https://your-app.onrender.com
APP_URL=
# فقط برای سرویس TEST؛ در Production تنظیم نشود.
ALLOW_TEST_MAINTENANCE=false
# یوزرنیم ربات بدون @ و نام کوتاه مینی‌اپ (برای ساخت لینک دعوت)
BOT_USERNAME=
MINI_APP_SHORT_NAME=
# دامنه‌های مجاز CORS (با ویرگول جدا کنید). در production برای originهای مرورگر لازم است.
ALLOWED_ORIGINS=
# فقط برای مهاجرت موقت؛ بعد از ورود با session مقدار false بماند.
ALLOW_LEGACY_ADMIN_KEY=false
# secret جداگانه برای هش ضدتقلب Referral (در production حتماً تنظیم شود)
REFERRAL_RISK_SECRET=

# ===== اختیاری =====
# رمز webhook تلگرام (اگر تنظیم شود، سرور فقط درخواست‌های دارای این رمز را می‌پذیرد)
TELEGRAM_WEBHOOK_SECRET=
# حداکثر عمر initData تلگرام به ثانیه (پیش‌فرض ۸۶۴۰۰)
INIT_DATA_MAX_AGE=86400
# محدودیت‌های قدیمی eligibility برای تبدیل/برداشت Referral؛ پاداش اولیه ۱۰ پوینت به این انتظار وابسته نیست.
REFERRAL_MIN_TASKS=3
REFERRAL_MIN_ACTIVE_DAYS=2
REFERRAL_WAIT_DAYS=7
# عضویت اجباری: چند ثانیه نتیجه‌ی «تایید شده» در سرور کش شود (۰ = بدون کش، پیش‌فرض ۳۰)
MEMBERSHIP_CACHE_TTL_SECONDS=30
# کلید API اختیاری TON Center v3 Mainnet؛ فقط روی سرور تنظیم شود، هیچ‌وقت در Frontend قرار نگیرد.
TONCENTER_API_KEY=

# ===== تبلیغات AdsGram (پاداش اختیاری در تب «روزانه») =====
# شناسه بلاک Reward از partner.adsgram.ai → بلاک → «Show code» → «Copy BlockID» (فقط عدد)
ADSGRAM_BLOCK_ID=
# پاداش هر تماشای کامل تبلیغ، سقف روزانه و فاصله‌ی بین دو پاداش (ثانیه)
ADSGRAM_REWARD_POINTS=5
ADSGRAM_DAILY_LIMIT=10
ADSGRAM_COOLDOWN_SECONDS=30
# اختیاری (برای اپ‌های بالای ۵۰ هزار کاربر روزانه): اگر پر شود پاداش فقط از Reward URL داده می‌شود.
# Reward URL در AdsGram: https://آدرس-شما/api/ads/adsgram-reward?userid=[userId]&secret=همین_مقدار
ADSGRAM_REWARD_SECRET=

# ===== کانال پرداخت‌ها (مدرک عمومی پرداخت) =====
# آیدی کانال عمومی پرداخت‌ها، مثلاً @GramUpPayouts — ربات باید ادمین کانال با اجازه ارسال پیام باشد
PAYOUT_CHANNEL_ID=
